<?xml version="1.0" encoding="utf-8"?>
<!--
  Экран, остающийся под уходящим или под приходящим, держится непрозрачным.

  Если гасить его одновременно с проявлением второго, на середине оба стоят
  примерно на половине прозрачности - и сквозь них просвечивает пустота. Этот
  провал и читается как рывок в конце перехода. Верхний экран проявляется или
  гаснет сам, нижний всё это время закрывает фон целиком.
-->
<alpha xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="260"
    android:fromAlpha="1.0"
    android:toAlpha="1.0" />
