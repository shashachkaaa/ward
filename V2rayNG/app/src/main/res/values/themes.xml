<resources>
    <color name="window_background_light">#FFFFFFFF</color>
    <color name="window_background_dark">#FF1C1B1F</color>

    <!--
      Общие пункты вынесены отдельным именем, чтобы не повторять их в наборе для
      API 27. Там переопределяется только AppThemeBase: квалификатор подменяет стиль
      целиком, а не дописывает к нему, и без этого пришлось бы держать две копии
      всего списка и следить, чтобы они не разошлись.
    -->
    <style name="AppThemeCommon" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/window_background_light</item>
    </style>

    <style name="AppThemeBase" parent="AppThemeCommon" />

    <style name="AppThemeDayNight" parent="AppThemeBase" />

    <style name="AppThemeDayNight.NoActionBar" parent="AppThemeBase" />

    <style name="AppThemeDayNight.NoActionBar.Translucent" parent="AppThemeBase">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
    </style>
</resources>
