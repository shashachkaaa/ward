<?xml version="1.0" encoding="utf-8"?>
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <!--
      Открытый трафик разрешён намеренно. Приложение - клиент VPN: через него
      ходит чужой трафик, в том числе к локальному прокси на 127.0.0.1 и к узлам
      в локальной сети при раздаче. Запретить открытый трафик здесь значит
      обрубить всё это, а защищённость пользователя от такого запрета не растёт:
      его трафик и так уходит в туннель.
    -->
    <base-config
        cleartextTrafficPermitted="true"
        tools:ignore="InsecureBaseConfiguration">
        <trust-anchors>
            <certificates src="system" />
            <certificates
                src="user"
                tools:ignore="AcceptsUserCertificates" />
        </trust-anchors>
    </base-config>
</network-security-config>
